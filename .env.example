# Copy to .env (or set everything from the dashboard: Boto -> AI brains / Connections).
# Dashboard settings are saved to settings.json and override this file.

# --- Default AI brain: ollama | openai | anthropic | gemini | deepseek | qwen ---
LLM_PROVIDER=ollama
PARALLEL=3

# Ollama Cloud (key: https://ollama.com/settings/keys) or local: OLLAMA_URL=http://localhost:11434 with no key
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# OpenAI ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Qwen / DashScope (pick the endpoint for your region)
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Office behaviour ---
BRAND_PROFILE=We are a friendly company. Tone: warm, short, helpful. Reply in the customer's language.
# false = customer replies wait on the board for Approve / Edit / Reject
AUTO_SEND=false
PM_REVIEW=true
COFFEE_SECONDS=12

# --- Email (IMAP in / SMTP out). Gmail: imap.gmail.com / smtp.gmail.com + an App Password ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_POLL_SECONDS=60

# --- Meta (WhatsApp Cloud API + Instagram Graph API) ---
WEBHOOK_VERIFY_TOKEN=change-me
WA_TOKEN=
WA_PHONE_ID=
IG_TOKEN=
IG_USER_ID=
